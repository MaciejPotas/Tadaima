<?xml version='1.0' encoding='utf-8'?>
<sentence_maps schema_version="6">
  <sentence_patterns>
    <sentence_pattern id="simple" label="simple">
      <question>{context.pl_prefix}{verb.prompt}.</question>
      <answer>{context.jp_prefix}{verb.form}</answer>
    </sentence_pattern>
    <sentence_pattern id="transitive_object" label="transitive_object">
      <question>{context.pl_prefix}{verb.prompt} {object.pl_accusative}.</question>
      <answer>{context.jp_prefix}{object}を{verb.form}</answer>
    </sentence_pattern>
    <sentence_pattern id="described_object_action" label="described_object_action">
      <question>Ułóż zdanie: {context.pl_prefix}{verb.prompt}; {adjective.prompt} {object.pl_nominative}.</question>
      <answer>{context.jp_prefix}{adjective.attributive}{object}を{verb.form}</answer>
    </sentence_pattern>
    <sentence_pattern id="destination" label="destination">
      <question>{context.pl_prefix}{verb.prompt} do {destination.pl_genitive}.</question>
      <answer>{context.jp_prefix}{destination}へ{verb.form}</answer>
    </sentence_pattern>
    <sentence_pattern id="companion" label="companion">
      <question>{context.pl_prefix}{verb.prompt} z {companion.pl_instrumental}.</question>
      <answer>{context.jp_prefix}{companion}と{verb.form}</answer>
    </sentence_pattern>
    <sentence_pattern id="adjective_predicate" label="adjective_predicate">
      <question>{subject.pl_demonstrative} {adjective.prompt}.</question>
      <answer>この{subject}は{adjective.form}</answer>
    </sentence_pattern>
    <sentence_pattern id="adjective_simple" label="adjective_simple">
      <question>To {adjective.prompt}.</question>
      <answer>これは{adjective.form}</answer>
    </sentence_pattern>
    <sentence_pattern id="adjective_attributive" label="adjective_attributive">
      <question>To {copula.prompt} {adjective.prompt} {subject.pl_nominative}.</question>
      <answer>これは{adjective.attributive}{subject}{copula.form}</answer>
    </sentence_pattern>
    <sentence_pattern id="quoted_predicate" label="quoted_predicate">
      <question>{reporting_verb.prompt}, że {subject.pl_demonstrative} {predicate.prompt}.</question>
      <answer>あの{subject}が{predicate.plain_nonpast}と{reporting_verb.form}</answer>
    </sentence_pattern>
    <sentence_pattern id="te_iru_object" label="te_iru_object">
      <question>Użyj formy ている: {verb.translation}; {object.pl_accusative}.</question>
      <answer>{object}を{verb.te}{progressive_auxiliary.form}</answer>
    </sentence_pattern>
    <sentence_pattern id="before_action" label="before_action">
      <question>Ułóż zdanie: przed czynnością „{verb_before.translation}”; {verb_main.prompt} {object.pl_accusative}.</question>
      <answer>{verb_before.dictionary}まえに{object}を{verb_main.form}</answer>
    </sentence_pattern>
  </sentence_patterns>
</sentence_maps>
